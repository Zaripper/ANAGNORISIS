datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMINISTRATEUR
  CAISSIER
  AGENT
}

enum DocumentType {
  ACHAT
  /// Purchase order to a supplier. No stock or ledger effect of its own —
  /// receiving it generates a real ACHAT (see receiveCommande).
  COMMANDE
  /// Bon de livraison: sort le stock et debite le compte client. La facture
  /// emise a partir d'un BL ne refait ni l'un ni l'autre (voir sourceDocumentId).
  BON_LIVRAISON
  BON_PREPARATION
  VENTE
  FACTURE
  PROFORMA
  RETOUR_CLIENT
  RETOUR_FOURNISSEUR
  REGULE_PLUS
  REGULE_MOINS
  TRANSFERT
}

/// EXPIRE: bon de preparation dont la duree de validite est depassee. La
/// reservation de stock a ete liberee, le document reste consultable mais n'est
/// plus validable. Un BP oublie ne doit pas immobiliser du stock indefiniment.
enum DocumentStatus {
  OUVERT
  VALIDE
  ANNULE
  EXPIRE
}

enum PaymentMode {
  ESPECE
  CHEQUE
  TRAITE
  VIREMENT
}

enum CashTxType {
  RECETTE
  DEPENSE
}

/// Etat d'une ecriture de caisse.
/// OUVERT: saisie par un caissier, sans effet sur le solde du partenaire.
/// VALIDE: imputee. C'est le seul etat qui bouge un solde.
/// ANNULE: annulee; si elle avait ete validee, son imputation est contrepassee.
enum CashStatus {
  OUVERT
  VALIDE
  ANNULE
}

/// Etats d'un cheque, repris du logiciel actuel.
/// EN_INSTANCE: recu, pas encore remis en banque (cheques recette uniquement).
/// MIS_EN_PAIEMENT: remis en banque (recette) ou emis (depense).
/// PAYE: encaisse ou debite — c'est la que l'ecriture de banque est generee.
/// ANNULE: impaye ou annule — les effets deja imputes sont contrepasses.
enum ChequeEtat {
  EN_INSTANCE
  MIS_EN_PAIEMENT
  PAYE
  ANNULE
}

/// Mode de saisie des quantites sur une ligne.
/// VRAC: la quantite est saisie a l'unite (detail).
/// COLISAGE: l'operateur saisit un nombre de colis, la quantite en unites en
/// decoule du colisage de l'article (gros).
enum Emballage {
  VRAC
  COLISAGE
}

/// Politique de prix d'un article pour une categorie de partenaire.
/// PRIX_SAISI: le prix de vente est saisi tel quel.
/// TAUX: le prix est derive du P.U.M.P par application d'un taux de marge.
enum PricePolicy {
  PRIX_SAISI
  TAUX
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(ADMINISTRATEUR)
  active       Boolean  @default(true)
  /// Forces a password change at next login. Set on seeded/default accounts and
  /// whenever an admin resets someone's password.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Livreur {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  phone     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

model Zone {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  partners  Partner[]
}

model ChargeClass {
  id        String    @id @default(uuid())
  code      String    @unique
  label     String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  charges   Charge[]
}

/// Sens dans lequel un motif de regularisation peut etre employe.
/// Une casse ne fait jamais entrer de marchandise; un ecart d'inventaire peut
/// aller dans les deux sens. Filtrer les motifs par sens evite d'expliquer une
/// entree de stock par une casse.
enum ReguleSens {
  PLUS
  MOINS
  TOUS
}

/// Motifs de regularisation de stock (casse, perte, ecart d'inventaire...).
///
/// C'est la table de reference derriere "Fichier > Types des regules". Elle
/// existe pour que les regularisations soient expliquees par un motif choisi
/// dans une liste fermee plutot que par du texte libre: sans cela, "casse",
/// "Casse", "cassé" et "carton tombé" deviennent quatre motifs distincts et
/// aucun etat des pertes n'est possible.
model TypeRegule {
  id        String     @id @default(uuid())
  code      String     @unique
  label     String
  sens      ReguleSens @default(TOUS)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

/// Key/value application settings (company identity for printed documents,
/// numbering preferences...). Admin-editable from the Paramètres screen.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Comment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Depot {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stocks        ArticleStock[]
  lots          Lot[]
  lines         DocumentLine[]
  documents     Document[]     @relation("DocumentSourceDepot")
  destDocuments Document[]     @relation("DocumentDestDepot")
}

/// Partner categories are admin-defined (not a fixed enum) so the business can add
/// its own tiers (e.g. "Grossiste Nord", "Pharmacies Réseau Sud") from the UI.
/// `isSupplier` decides whether a partner in this category shows up as a client
/// (sales screens) or a supplier (purchases screen).
model PartnerCategory {
  id        String         @id @default(uuid())
  code      String         @unique
  label     String
  isSupplier Boolean       @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  partners  Partner[]
  prices    ArticlePrice[]
}

model Partner {
  id               String            @id @default(uuid())
  code             String            @unique
  raisonSociale    String
  categoryId       String
  category         PartnerCategory   @relation(fields: [categoryId], references: [id])
  zoneId           String?
  zone             Zone?             @relation(fields: [zoneId], references: [id])
  seuilAutorise    Decimal           @default(0.0)
  balance          Decimal           @default(0.0)
  /// Coordonnees (bloc "Coordonnees" de la fiche partenaire)
  address          String?
  pays             String?
  codePostal       String?
  ville            String?
  phone            String?
  fax              String?
  mobile           String?
  email            String?
  siteInternet     String?
  /// Personne a contacter chez ce partenaire.
  contact          String?
  /// Identifiants fiscaux — obligatoires pour l'Etat 104 et les mentions de facture.
  /// nif correspond au champ "M.F." (matricule fiscal) du logiciel d'origine.
  nif              String?
  rc               String?
  ai               String?
  nis              String?
  nin              String?
  /// Le partenaire est eligible a une refaction sur ses achats.
  peutAvoirRefaction Boolean         @default(false)
  /// Blocage: quand il est actif, le partenaire est bloque des que son solde
  /// depasse `seuilAutorise`, ou que sa dette est ouverte depuis plus de
  /// `blocageJours` jours a compter de `blocageDateReference`.
  blocageActif         Boolean       @default(false)
  blocageDateReference DateTime?
  blocageJours         Int?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documents        Document[]
  cashTransactions CashTransaction[]
  cheques          Cheque[]
  suppliedArticles Article[]         @relation("ArticleMainSupplier")

  @@index([categoryId])
  @@index([zoneId])
}

model Article {
  id          String         @id @default(uuid())
  code        String         @unique
  barcode     String?
  designation String
  category    String?
  pump        Decimal        @default(0.0)
  tvaRate     Decimal        @default(19.0)
  /// Nombre d'unites par colis (0 = vendu uniquement a l'unite).
  colisage    Int            @default(0)
  /// Suivi par lot et date de peremption. Optionnel article par article: le
  /// catalogue existant n'a pas de lots, et l'imposer bloquerait chaque vente.
  /// Seuls les articles ainsi marques exigent une allocation de lot.
  suiviLot    Boolean        @default(false)
  /// Prix public (PPA). Prix de reference affiche au client, distinct du prix de
  /// vente negocie par categorie: le commercial doit voir les deux pour savoir
  /// de combien il s'ecarte du tarif public.
  ppa         Decimal        @default(0.0)
  /// Taux maximal d'unites gratuites accorde sur cet article, en pourcentage de
  /// la quantite facturee. Sert de garde-fou a la saisie: au-dela, le vendeur
  /// donne plus que ce que la marge permet.
  tauxUGAutorise Decimal     @default(0.0)
  /// Taux de refaction applicable a l'article, en pourcentage.
  tauxRefaction Decimal      @default(0.0)
  /// Stock de securite: quantite en dessous de laquelle il ne faut pas descendre.
  securite    Int?
  /// Seuil d'alerte: declenche l'apparition dans "Articles a reapprovisionner".
  seuilReappro Int?
  /// Quantite a commander lorsque le seuil d'alerte est atteint.
  quantiteReappro Int?
  /// Fournisseur habituel de l'article.
  mainSupplierId String?
  mainSupplier   Partner?    @relation("ArticleMainSupplier", fields: [mainSupplierId], references: [id])
  active      Boolean        @default(true)
  /// Article mis en avant a la caisse (onglet Preferes).
  preferred   Boolean        @default(false)
  /// Contingentement des produits rares: quantite maximale qu'un meme client peut
  /// prendre sur un document. null = pas de limite.
  maxQtyPerClient Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  prices      ArticlePrice[]
  stocks      ArticleStock[]
  lots        Lot[]
  lines       DocumentLine[]

  @@index([barcode])
  @@index([designation])
  @@index([mainSupplierId])
}

model ArticlePrice {
  id         String          @id @default(uuid())
  articleId  String
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  categoryId String
  category   PartnerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceHT    Decimal         @default(0.0)
  priceTTC   Decimal         @default(0.0)
  /// PRIX_SAISI: priceHT fait foi. TAUX: priceHT est recalcule depuis le P.U.M.P
  /// et `taux`, pour que la marge reste constante quand le cout d'achat bouge.
  policy     PricePolicy     @default(PRIX_SAISI)
  taux       Decimal         @default(0.0)
  updatedAt  DateTime        @updatedAt

  @@unique([articleId, categoryId])
}

model ArticleStock {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  depotId     String
  depot       Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  qtyInStock  Int      @default(0)
  qtyReserved Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([articleId, depotId])
}

/// Un lot de marchandise: meme article, meme depot, meme numero de lot, meme
/// date de peremption.
///
/// Les lots NE SONT PAS une source de verite paralelle au stock: ArticleStock
/// reste le total qui fait foi, et les lots en sont la ventilation. Toute
/// operation qui touche l'un touche l'autre du meme montant, sans quoi les deux
/// divergent et plus personne ne sait ce qu'il y a en rayon.
///
/// Le P.U.M.P reste porte par l'article, pas par le lot: le cout moyen pondere
/// se calcule sur l'ensemble des entrees, quel que soit le lot.
model Lot {
  id             String            @id @default(uuid())
  articleId      String
  article        Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  depotId        String
  depot          Depot             @relation(fields: [depotId], references: [id], onDelete: Cascade)
  numeroLot      String
  datePeremption DateTime
  qtyInStock     Int               @default(0)
  qtyReserved    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  allocations    DocumentLineLot[]

  /// Un meme numero de lot peut exister dans deux depots: la cle inclut donc le depot.
  @@unique([articleId, depotId, numeroLot, datePeremption])
  /// Sert au balayage FEFO et a l'ecran des peremptions.
  @@index([datePeremption])
  @@index([articleId, depotId])
}

/// Repartition d'une ligne de document sur les lots reellement servis.
///
/// Une ligne peut couvrir plusieurs lots: demander 100 unites alors que le lot
/// le plus proche de la peremption n'en contient que 60 doit servir 60 puis 40
/// du suivant. Sans cette table, on ne saurait pas quel lot a ete livre a quel
/// client -- l'information meme qu'un rappel de lot exige.
model DocumentLineLot {
  id             String       @id @default(uuid())
  documentLineId String
  documentLine   DocumentLine @relation(fields: [documentLineId], references: [id], onDelete: Cascade)
  lotId          String
  lot            Lot          @relation(fields: [lotId], references: [id])
  quantity       Int

  @@index([documentLineId])
  @@index([lotId])
}

model Document {
  id                 String            @id @default(uuid())
  reference          String            @unique
  supplierInvoiceNum String?
  type               DocumentType
  status             DocumentStatus    @default(OUVERT)
  partnerId          String?
  partner            Partner?          @relation(fields: [partnerId], references: [id])
  depotId            String
  depot              Depot             @relation("DocumentSourceDepot", fields: [depotId], references: [id])
  destDepotId        String?
  destDepot          Depot?            @relation("DocumentDestDepot", fields: [destDepotId], references: [id])
  livreurId          String?
  livreur            Livreur?          @relation(fields: [livreurId], references: [id])
  paymentMode        PaymentMode       @default(ESPECE)
  totalHT            Decimal           @default(0.0)
  remise             Decimal           @default(0.0)
  totalTVA           Decimal           @default(0.0)
  stampDuty          Decimal           @default(0.0)
  totalTTC           Decimal           @default(0.0)
  marginHT           Decimal           @default(0.0)
  marginPercent      Decimal           @default(0.0)
  /// Motif de regularisation (regules uniquement), choisi dans la table de
  /// reference. `motif` reste disponible en complement libre: le type dit
  /// "casse", le motif precise "carton tombe en reserve".
  typeReguleId       String?
  typeRegule         TypeRegule?       @relation(fields: [typeReguleId], references: [id])
  motif              String?
  /// Document d'origine (facture emise depuis un bon de livraison). Quand il est
  /// renseigne, la validation n'a AUCUN effet stock ni comptable: tout a deja ete
  /// impute par le document source. Sans cela chaque livraison serait comptee deux fois.
  sourceDocumentId   String?           @unique
  sourceDocument     Document?         @relation("DocumentFacturation", fields: [sourceDocumentId], references: [id])
  facture            Document?         @relation("DocumentFacturation")
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  validatedAt        DateTime?
  cancelledAt        DateTime?
  /// Date limite de validite (bons de preparation). Figee a la creation a partir
  /// du parametre BP_DUREE_VALIDITE_JOURS: changer le parametre ne doit pas faire
  /// expirer retroactivement les bons deja prepares.
  dateValidite       DateTime?
  expiredAt          DateTime?
  lines              DocumentLine[]
  charges            Charge[]
  cashTransactions   CashTransaction[]

  @@index([partnerId])
  @@index([livreurId])
  @@index([typeReguleId])
  @@index([type, status])
  @@index([createdAt])
  /// Sert au balayage des bons de preparation echus.
  @@index([status, dateValidite])
}

model DocumentLine {
  id               String   @id @default(uuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  articleId        String
  article          Article  @relation(fields: [articleId], references: [id])
  depotId          String
  depot            Depot    @relation(fields: [depotId], references: [id])
  /// Quantite facturee, en unites. Le bonus n'y est PAS inclus.
  quantity         Int
  unitPriceHT      Decimal
  discountPercent  Decimal  @default(0.0)
  tvaRate          Decimal
  totalHT          Decimal  @default(0.0)
  totalTTC         Decimal  @default(0.0)
  purchaseCostPUMP Decimal  @default(0.0)
  /// Mode de saisie de la quantite: au colis (gros) ou a l'unite (detail).
  emballage        Emballage @default(VRAC)
  /// Nombre de colis saisi quand emballage = COLISAGE. La quantite en unites en
  /// decoule (nbColis x colisage de l'article) et reste la seule reference pour
  /// le stock.
  nbColis          Int?
  /// Numero de colis porte sur le bon de livraison, pour le suivi physique.
  numeroColis      String?
  /// Quantite offerte. Elle sort du stock mais ne se facture pas.
  quantiteBonus    Int      @default(0)
  /// Ristourne en valeur, appliquee apres la remise en pourcentage.
  ristourne        Decimal  @default(0.0)
  /// Entrees uniquement: numero de lot et peremption saisis a la reception.
  numeroLot        String?
  datePeremption   DateTime?
  /// Sorties uniquement: quels lots ont reellement ete servis.
  lots             DocumentLineLot[]

  @@index([documentId])
  @@index([articleId])
}

model Charge {
  id             String       @id @default(uuid())
  chargeClassId  String
  chargeClass    ChargeClass  @relation(fields: [chargeClassId], references: [id])
  amount         Decimal
  description    String
  paymentMode    PaymentMode  @default(ESPECE)
  date           DateTime     @default(now())
  documentId     String?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([chargeClassId])
  @@index([documentId])
}

/// Cheque suivi dans le temps, contrairement a une simple ecriture de caisse.
///
/// Effets comptables, volontairement explicites:
///  - a la creation, le solde du partenaire est impute (le cheque vaut reglement);
///  - au passage a PAYE, une ecriture de banque est generee;
///  - a l'annulation, tout ce qui a ete impute est contrepasse.
model Cheque {
  id           String      @id @default(uuid())
  /// RECETTE: cheque recu d'un client. DEPENSE: cheque emis a un fournisseur.
  type         CashTxType
  etat         ChequeEtat  @default(EN_INSTANCE)
  numeroPiece  String?
  datePiece    DateTime    @default(now())
  partnerId    String
  partner      Partner     @relation(fields: [partnerId], references: [id])
  numeroCheque String
  dateCheque   DateTime?
  banque       String?
  montant      Decimal
  libelle      String?
  /// Ecriture de banque generee au moment du passage a PAYE.
  cashTransactionId String? @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id])
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([type, etat])
  @@index([partnerId])
}

model CashTransaction {
  id          String      @id @default(uuid())
  documentId  String?
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  partnerId   String?
  partner     Partner?    @relation(fields: [partnerId], references: [id])
  reference   String?
  bankName    String?
  type        CashTxType
  amount      Decimal
  paymentMode PaymentMode
  description String
  /// Etat de l'ecriture. La valeur par defaut est VALIDE, et c'est deliberé:
  /// les ecritures nees d'un document ou d'un cheque sont deja le reflet d'une
  /// operation validee ailleurs, et ne doivent surtout pas attendre une
  /// seconde validation. Seule la saisie manuelle de caisse part en OUVERT.
  status      CashStatus  @default(VALIDE)
  createdById String?
  validatedById String?
  validatedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())
  cheque      Cheque?

  @@index([createdAt])
  @@index([partnerId])
  @@index([status, paymentMode])
}
